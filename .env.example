# ==========================================
# Frontend Environment Variables (.env.local)
# ==========================================
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1

# ==========================================
# Backend Environment Variables (.env)
# ==========================================

# Environment: development | staging | production
ENVIRONMENT=development

# Database (Neon PostgreSQL)
# For local dev: omit DATABASE_URL to use SQLite automatically.
# For production: set to your Neon connection string.
# Neon pooler format (recommended):
DATABASE_URL=postgresql://neondb_owner:xxxx@ep-xxx.us-east-2.aws.neon.tech/neondb?sslmode=require
# Direct connection format (for Alembic migrations):
# DATABASE_URL=postgresql://neondb_owner:xxxx@ep-xxx.us-east-2.aws.neon.tech/neondb?sslmode=require

# Authentication
# Generate with: openssl rand -hex 32
JWT_SECRET=your_production_jwt_secret_here
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# AI Configuration
DEMO_MODE=true

# External AI Provider Keys (only needed if DEMO_MODE=false)
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# Email (Resend)
RESEND_API_KEY=
SENDER_EMAIL=onboarding@resend.dev
SENDER_NAME=PRFlow AI

# CORS (JSON array of allowed origins)
CORS_ORIGINS=["http://localhost:3000","https://your-domain.vercel.app"]
