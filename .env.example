# ==========================================
# Frontend Environment Variables (.env.local)
# ==========================================
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1

# ==========================================
# Backend Environment Variables (.env)
# ==========================================
# Database Connection (Matches docker-compose.yml by default)
DATABASE_URL=postgresql://postgres:password@localhost:5432/prflow

# Authentication
# Generate a secret key using: openssl rand -hex 32
JWT_SECRET=your_super_secret_jwt_key_here
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# AI Configuration
# Set DEMO_MODE=true to run without external API keys
DEMO_MODE=true

# External AI Provider Keys (Required if DEMO_MODE=false)
OPENAI_API_KEY=sk-your-openai-key-here
ANTHROPIC_API_KEY=sk-ant-your-anthropic-key-here

# CORS Configuration
CORS_ORIGINS=["http://localhost:3000"]
